FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS base
WORKDIR /app

FROM base AS build
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --workspace=web --workspace=@quiz-battle/shared --no-audit --no-fund

COPY apps/web/next.config.js apps/web/next-env.d.ts apps/web/tsconfig.json apps/web/
COPY apps/web/public/ apps/web/public/
COPY apps/web/src/ apps/web/src/
COPY packages/shared/tsconfig.json packages/shared/tsconfig.build.json packages/shared/
COPY packages/shared/src/ packages/shared/src/
RUN npm run build --workspace=@quiz-battle/shared

# Next.js inlines public browser configuration during the build.
ARG NEXT_PUBLIC_API_URL
RUN node -e '\
  const value = process.env.NEXT_PUBLIC_API_URL; \
  try { \
    const api = new URL(value); \
    const host = api.hostname.toLowerCase().replace(/^\[|\]$/g, "").replace(/\.$/, ""); \
    const parts = host.split(".").map(Number); \
    const localName = host === "localhost" || /\.(localhost|local|lan|internal)$/.test(host); \
    const localV6 = host.includes(":") && (host === "::" || host === "::1" || host.startsWith("::ffff:") || /^(f[cd]|fe[89ab]|ff)/.test(host)); \
    const localV4 = /^\d+\.\d+\.\d+\.\d+$/.test(host) && (parts[0] === 0 || parts[0] === 10 || parts[0] === 127 || parts[0] >= 224 || \
      (parts[0] === 169 && parts[1] === 254) || (parts[0] === 192 && parts[1] === 168) || \
      (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) || (parts[0] === 100 && parts[1] >= 64 && parts[1] <= 127)); \
    if (api.protocol !== "https:" || api.origin !== value || localName || localV6 || localV4) throw new Error(); \
  } catch { \
    console.error("Set NEXT_PUBLIC_API_URL to the public HTTPS API origin without a trailing slash."); \
    process.exit(1); \
  }' && npm run build --workspace=web

FROM base AS runtime
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --omit=dev --workspace=web --workspace=@quiz-battle/shared --no-audit --no-fund

COPY --from=build /app/packages/shared/dist/ packages/shared/dist/
COPY --from=build --chown=node:node /app/apps/web/.next/ apps/web/.next/
COPY --from=build /app/apps/web/public/ apps/web/public/
COPY --from=build /app/apps/web/next.config.js apps/web/

WORKDIR /app/apps/web
USER node
EXPOSE 3000
CMD ["sh", "-c", "exec node /app/node_modules/next/dist/bin/next start -H 0.0.0.0 -p \"${PORT:-3000}\""]
